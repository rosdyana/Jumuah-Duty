# Copy this file to .env (git-ignored) and fill in real values.
# cp env.example .env

# --- Database ---
# Local dev matches docker-compose.yml defaults.
DATABASE_URL="mysql://masjid:masjid@localhost:3306/masjid"
MYSQL_DATABASE=masjid
MYSQL_USER=masjid
MYSQL_PASSWORD=masjid
MYSQL_ROOT_PASSWORD=root

# --- App / Docker Compose ---
# Host port docker-compose binds the app container to (127.0.0.1 only — point
# your reverse proxy, e.g. Caddy, at this). Change this if 3000 is already
# taken by another service on the host. The container's internal port (used
# by the scheduler over the compose network) is unaffected either way.
APP_PORT=3000

# --- Auth (NextAuth v5 / Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Microsoft Entra ID (Azure AD) app registration ---
# Redirect URI to register: {AUTH_URL}/api/auth/callback/microsoft-entra-id
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Jumuah Duty Scheduler <noreply@example.com>"

# --- Scheduler ---
# Shared secret the scheduler container sends as the x-cron-secret header.
CRON_SECRET=
# IANA timezone used for "is tomorrow Friday" checks and schedule dates.
APP_TIMEZONE=Asia/Jakarta

# --- Seed (first admin bootstrap, prisma/seed.ts) ---
SEED_ADMIN_EMAIL=rosdyana_kusuma@asus.com
SEED_ADMIN_NAME="Rosdyana Kusuma"
